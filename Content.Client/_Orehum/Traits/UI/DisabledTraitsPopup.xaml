<controls:FancyWindow
    MinSize="400 200"
    SetSize="500 350"
    Title="{Loc disabled-traits-popup-title}"
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Margin="10" Orientation="Vertical">
        <!--  Header  -->
        <BoxContainer Margin="0,0,0,10" Orientation="Horizontal">
            <TextureRect
                Margin="0,0,10,0"
                TexturePath="/Textures/Interface/info.svg.192dpi.png"
                TextureScale="0.5 0.5"
                VerticalAlignment="Center" />
            <Label
                Name="TitleLabel"
                StyleClasses="LabelHeading"
                VAlign="Center" />
        </BoxContainer>

        <!--  Message  -->
        <RichTextLabel Margin="0,0,0,15" Name="MessageLabel" />

        <!--  List of disabled traits  -->
        <Label
            Margin="0,0,0,5"
            StyleClasses="LabelSubText"
            Text="{Loc disabled-traits-popup-list-header}" />

        <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer
                    Margin="5"
                    Name="DisabledTraitsContainer"
                    Orientation="Vertical" />
            </ScrollContainer>
        </PanelContainer>

        <!--  Footer with checkbox and close button  -->
        <BoxContainer Margin="0,10,0,0" Orientation="Vertical">
            <CheckBox
                HorizontalAlignment="Center"
                Name="SkipCheckBox"
                Text="{Loc disabled-traits-popup-skip-checkbox}" />

            <Button
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                MinSize="120 0"
                Name="ButtonClose"
                Text="{Loc disabled-traits-popup-close-button}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
