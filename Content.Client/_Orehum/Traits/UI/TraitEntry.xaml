<PanelContainer
    HorizontalExpand="True"
    Margin="0,0,0,4"
    Name="EntryPanel"
    StyleClasses="TraitsEntryPanel"
    xmlns="https://spacestation14.io">

    <BoxContainer
        HorizontalExpand="True"
        Margin="10,8"
        Orientation="Horizontal">

        <!--  Toggle Container  -->
        <BoxContainer
            Margin="0,2,10,0"
            Name="ToggleContainer"
            Orientation="Horizontal"
            SetWidth="24"
            VerticalAlignment="Top">

            <!--  Checkbox  -->
            <CheckBox
                Name="TraitCheckbox"
                StyleClasses="TraitsEntryCheckbox"
                VerticalAlignment="Center" />

            <!--  Lock Icon  -->
            <TextureRect
                HorizontalAlignment="Center"
                Name="LockIcon"
                SetSize="20 20"
                Stretch="KeepAspectCentered"
                TexturePath="/Textures/Interface/VerbIcons/lock.svg.192dpi.png"
                VerticalAlignment="Center"
                Visible="False" />
        </BoxContainer>

        <!--  Trait Info  -->
        <BoxContainer
            HorizontalExpand="True"
            Name="TraitInfo"
            Orientation="Vertical"
            VerticalAlignment="Center">

            <!--  Name and Cost Row  -->
            <BoxContainer Orientation="Horizontal">
                <Label Name="TraitNameLabel" StyleClasses="TraitsEntryNameLabel" />
                <Control HorizontalExpand="True" />
                <Label Name="TraitCostLabel" StyleClasses="TraitsEntryCostLabel" />
            </BoxContainer>

            <!--  Description  -->
            <RichTextLabel
                Margin="0,4,0,0"
                Name="TraitDescriptionLabel"
                StyleClasses="TraitsEntryDescriptionLabel" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
